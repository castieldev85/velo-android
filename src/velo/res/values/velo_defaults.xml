<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Velo: cifratura sempre attiva, mai messaggi in chiaro. -->
    <string name="omemo_setting_default">always</string>
    <!-- Velo: bolle colorate (inviata = primaryContainer, ricevuta = secondaryContainer) -->
    <bool name="use_green_background">true</bool>
    <!-- Velo: nessuna richiesta a server esterni (anteprime mappe di upstream, elenco provider) -->
    <bool name="show_maps_inside">false</bool>
    <bool name="load_providers_list_external">false</bool>
    <string name="mappreview_url" translatable="false"></string>
    <string name="example_jid" translatable="false">nome@example.com</string>
    <!-- Velo 0.10: niente metadati regalati. Conferme di lettura, "sta scrivendo" e ultimo
         accesso partono spenti ma si possono riaccendere; anteprime dei link e reazioni in chiaro
         sono bloccate (VeloPrivacy, XmppConnectionService.sendMessage, ConversationFragment). -->
    <bool name="confirm_messages">false</bool>
    <bool name="chat_states">false</bool>
    <bool name="last_activity">false</bool>
    <bool name="send_link_previews">false</bool>
    <bool name="allow_unencrypted_reactions">false</bool>
    <!-- Velo 0.10: chiamate sempre tramite il relay del server (AppSettings.isUseRelays) -->
    <bool name="use_relays">true</bool>
    <!-- Velo: navigazione stile Telegram, menu laterale e niente barra in basso -->
    <bool name="show_nav_bar">false</bool>
    <bool name="show_nav_drawer">true</bool>
    <!-- Velo 0.40: monocles turned this off; Velo keeps downloading files on Wi-Fi by itself
         (only from the own server, through Tor), as up to 0.39 -->
    <bool name="auto_accept_unmetered">true</bool>
</resources>
