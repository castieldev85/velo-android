<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.drawerlayout.widget.DrawerLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false">

<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <!-- Content runs the full height; the bars below float on top of it and the
         fragments pad themselves clear of the bars via FloatingBars. -->
    <FrameLayout
        android:id="@+id/main_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/top_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="?attr/colorSurface"
        android:elevation="0dp"
        android:orientation="vertical">

        <!-- Velo 0.15: light top bar (surface colour) with a bold title; the theme's main colour stays on buttons and badges -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurface"
                android:minHeight="56dp"
                android:theme="@style/ThemeOverlay.Velo.ColourBar"
                app:buttonGravity="center_vertical" >

                <eu.siacs.conversations.ui.widget.AvatarView
                    android:id="@+id/toolbar_avatar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="8dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/toolbar_title"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/actionbar_text_size" />

                    <LinearLayout
                        android:id="@+id/velo_tor_chat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/velo_tor_chat_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/velo_tor_chat_icon"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/velo_ic_tor" />

                            <TextView
                                android:id="@+id/velo_tor_chat_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:layout_marginEnd="6dp"
                                android:text="@string/velo_tor_name"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/toolbar_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.8"
                            android:ellipsize="end"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Velo: stato di Tor al centro della barra, al posto del nome, sulla lista chat -->
                <LinearLayout
                    android:id="@+id/velo_tor_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/velo_pill_on_bar"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/velo_tor_home_icon"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/velo_dot" />

                    <TextView
                        android:id="@+id/velo_tor_home_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/velo_tor_name"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Velo 0.24: a new version is out, on the chat list only -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/velo_update_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- Velo 0.21: stories of the contacts (and mine), above the chat list -->
        <HorizontalScrollView
            android:id="@+id/velo_stories_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:paddingHorizontal="10dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/velo_stories_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Velo 0.28: the chat filters as tabs, on the rounded top of the list.
             Velo 0.44: scrolling, as in Telegram, for the fifth tab (Requests) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/velo_home_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/velo_sheet_top"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingTop="8dp"
                android:visibility="gone" />
        </HorizontalScrollView>


        <include
            layout="@layout/view_audio_miniplayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/floating_bar_margin"
            android:layout_marginEnd="@dimen/floating_bar_margin"
            android:layout_marginBottom="@dimen/floating_bar_margin_bottom" />

    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/floating_nav_bar_height"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/floating_bar_margin"
        android:layout_marginHorizontal="@dimen/floating_bar_margin_horizontal"
        android:background="@drawable/bg_floating_nav"
        android:elevation="@dimen/floating_nav_elevation"
        app:labelVisibilityMode="labeled"
        app:activeIndicatorLabelPadding="@dimen/floating_nav_label_padding"
        app:itemPaddingTop="@dimen/floating_nav_item_padding_top"
        app:itemPaddingBottom="@dimen/floating_nav_item_padding_bottom"
        app:itemTextAppearanceActive="@style/TextAppearance.App.NavigationBarLabel"
        app:itemTextAppearanceInactive="@style/TextAppearance.App.NavigationBarLabel"
        app:menu="@menu/bottom_navigation_menu_chat"
        android:visibility="gone" />

</RelativeLayout>

    <com.mikepenz.materialdrawer.widget.MaterialDrawerSliderView
        android:id="@+id/drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_weight="2000"
        android:fitsSystemWindows="false" />

    </androidx.drawerlayout.widget.DrawerLayout>
</layout>
