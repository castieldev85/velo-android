<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Velo: no traffic in clear and no certificates added by the user -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
