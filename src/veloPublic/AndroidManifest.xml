<?xml version="1.0" encoding="utf-8"?>
<!--
    Velo 0.46.2: manifest only of the public Velo (./gradlew -PveloPublic), the one of the site,
    of GitHub and of Google Play. It removes two permissions that Google Play does not allow to a
    chat app and that the public Velo never uses:
    - REQUEST_INSTALL_PACKAGES: only the built-in updater (VeloUpdater) installs APKs, and it is
      off in the public Velo (VeloUpdater.enabled); an app from Google Play may update itself only
      through Google Play.
    - ACCESS_BACKGROUND_LOCATION: never requested by the code; live location runs in the
      foreground service of type "location", which needs no background permission.
    The group Velo keeps both (it updates itself from its server).

    Velo 0.46.3: also the broad photo and video access. Google Play allows it to a chat app only
    if the system photo picker cannot do the job; Velo picks attachments with the system picker,
    and the only code asking for these is ImportBackupActivity, which then asks for nothing
    (it requests only permissions the manifest declares) and the backup is chosen with "Open a
    file" instead of the automatic scan of shared storage.

    Velo 0.46.4: no "camera" foreground service. The connection service claimed it (and
    "microphone") only as a fallback to stay alive, never for a camera task; in the public Velo
    that fallback is "specialUse" (XmppConnectionService.startForegroundOrCatch). During a video
    call the camera works while Velo is on screen; "microphone" stays for calls.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CAMERA"
        tools:node="remove" />

    <application>
        <service
            android:name="eu.siacs.conversations.services.XmppConnectionService"
            android:foregroundServiceType="specialUse|systemExempted|microphone|location"
            tools:replace="android:foregroundServiceType" />
    </application>

</manifest>
